# Next.js inlines NEXT_PUBLIC_* vars at build time — set these before `npm run build`.

# Full URL of the backend API. Leave blank to use relative /api (proxied via
# the rewrite in next.config.js, which points at BACKEND_URL below).
NEXT_PUBLIC_API_URL=

# Must match the backend's API_KEY if auth is enabled there. This is exposed
# to the browser bundle — fine for a shared-key personal deployment, not a
# substitute for real per-user auth.
NEXT_PUBLIC_API_KEY=

# Used server-side by next.config.js's rewrite when NEXT_PUBLIC_API_URL is unset.
BACKEND_URL=http://localhost:2000
